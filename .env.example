# Copy to .env.local and set real values. Never commit .env.local.
RESEND_API_KEY=re_your_key
SAHEY_FROM_EMAIL=SAHEY <alerts@your-verified-domain.com>
SAHEY_TEST_RECIPIENT=you@example.com
# Android emulator: http://10.0.2.2:8081; iOS simulator: http://localhost:8081
# Physical phone: use your computer's LAN IP, for example http://192.168.1.10:8081
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081
