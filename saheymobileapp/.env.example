# Copy to .env.local. Restart Expo after changing environment settings.
# Physical phone: use the computer's LAN address on the same network.
# Android emulator: http://10.0.2.2:8083
# USB device with `adb reverse tcp:8083 tcp:8083`: http://127.0.0.1:8083
EXPO_PUBLIC_API_URL=http://192.168.1.10:8083

# Server-only values. Never prefix these with EXPO_PUBLIC_.
RESEND_API_KEY=re_replace_with_your_key
HALO_FROM_EMAIL=Halo <onboarding@resend.dev>
# A verified sender domain is required to send to other recipient addresses.
# Save up to 10 emergency contacts on the phone; distress emails use that list.
# HALO_TEST_RECIPIENTS and HALO_TEST_EMAIL are no longer used.

# Optional standalone server; not needed when using the Expo API route.
# EXPO_PUBLIC_DISTRESS_EMAIL_URL=http://192.168.1.10:8787/distress
# HALO_EMAIL_HOST=0.0.0.0
# HALO_EMAIL_PORT=8787
